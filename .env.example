# Публичный адрес сайта — для canonical, sitemap, Open Graph.
# На Vercel можно не задавать: возьмётся продакшн-адрес проекта. Задайте, когда подключите свой домен.
NEXT_PUBLIC_SITE_URL=

# Куда приходят заявки: Telegram-бот (создать через @BotFather)
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда бот пишет заявки
TELEGRAM_CHAT_ID=

# ── Антиспам форм заявок ──────────────────────────────────────────────
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget, домен byuro.online,
# режим «Managed»). Без этих двух переменных Turnstile просто выключен, формы работают.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 — без токена Turnstile заявку не принимать (по умолчанию: принять, но отметить)
TURNSTILE_STRICT=
# Upstash Redis (Vercel → Storage / Marketplace → Upstash Redis): общие лимиты и журнал
# для всех серверов Vercel. Без него — память одного сервера (лимиты слабее, журнал теряется).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Секрет для псевдонимов IP (любая длинная случайная строка). Не задан — используется токен бота.
ANTISPAM_SECRET=
# Доступ к журналу: https://byuro.online/api/antispam?token=<значение>&format=text (≥16 символов)
ANTISPAM_ADMIN_TOKEN=
# Необязательно: чат Telegram, куда присылать уведомления об отклонённых заявках
TELEGRAM_SPAM_CHAT_ID=
